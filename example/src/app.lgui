#export ./assets;
#export ./.htaccess;

#include ./components/navbar.lgui Navbar;
#include ./pages/home.lgui Home;
#include ./pages/not-found.lgui NotFound;

const lang = "en";
const head = <>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>${ args.title } - Leger-UI example</title>
    

    <script src="app.js" type="module"></script>
</>;

const page = <>
    <Navbar/>
    <main>${ this._use(args.component) }</main>
    <p>
        Test and more tests.
        <p>Test2</p>
        Test3
    </p>
</>;

function router(args) {
    if (args.path == "/") {
        this.title = "Home";
        return this.page({ component: Home });
    }
    else {
        this.title = "Not found";
        return this.page({ component: NotFound });
    }
}
const pages = {
    "index.html": "/",
    "404.html": "404"
};

return { onrender: router, page, pages, lang, head };