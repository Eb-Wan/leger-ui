#export ./assets;
#export ./.htaccess;

#define lang en;
#define head head.lgui;

#include ./components/navbar.lgui Navbar;
#include ./pages/home.lgui Home;
#include ./pages/not-found.lgui NotFound;

const page = <>
    <body>
        <Navbar/>
        <main>{ props.component }</main>
        <p>
            Test and more tests.
            <p>Test2</p>
            Test3
        </p>
    </body>
</>;

const router = (args) => {
    if (args.path == "/") return page(<Home />);
    else return <><page component={ <NotFound /> } /></>;
};

return { onrender: router };