<script name="onload">
    fetch("https://jsonplaceholder.typicode.com/users")
        .then(e => e.json())
        .then(e => {
            this.set("users", e)
        })
        .catch(e => console.log(e));
</script>

<script name="onrender">
    this.def("users", []);
    return this.main(args);
</script>

<template name="main">
    <ul>
        ${ this.users.map(e => this.use("user.lgs", e)).join("") }
    </ul>
</template>