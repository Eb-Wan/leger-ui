{
  "scopeName": "source.lgui",
  "name": "LGUI",
  "fileTypes": ["lgui"],
  "patterns": [
    { "include": "#preprocessor" },
    { "include": "#comment" },
    { "include": "#template" },
    { "include": "#string" },
    { "include": "#javascript" }
  ],
  "repository": {
    "preprocessor": {
      "name": "meta.preprocessor.lgui",
      "begin": "#",
      "end": ";",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.preprocessor.lgui" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.preprocessor.lgui" }
      },
      "patterns": [
        {
          "name": "keyword.control.preprocessor.lgui",
          "match": "\\b(include|define|export|print|log|warn|error)\\b"
        },
        {
          "name": "string.quoted.double.lgui",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.lgui", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.lgui",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.lgui", "match": "\\\\." }
          ]
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lgui",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.lgui",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "template": {
      "name": "meta.template.lgui",
      "begin": "<>",
      "end": "</>",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.tag.begin.lgui" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.lgui" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#htmlTag" },
        { "include": "#templateExpression" }
      ]
    },
    "templateExpression": {
      "name": "meta.embedded.expression.lgui",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.lgui" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.lgui" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#javascript" }
      ]
    },
    "htmlTag": {
      "patterns": [
        {
          "name": "meta.tag.sgml.html",
          "begin": "(<)([a-zA-Z][a-zA-Z0-9-]*)",
          "end": "(>|/>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.html" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#htmlAttribute" },
            { "include": "#templateExpression" }
          ]
        },
        {
          "name": "meta.tag.sgml.html",
          "begin": "(</)([a-zA-Z][a-zA-Z0-9-]*)",
          "end": "(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.html" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          }
        }
      ]
    },
    "htmlAttribute": {
      "patterns": [
        {
          "name": "meta.attribute.html",
          "match": "([a-zA-Z_:][a-zA-Z0-9_:.-]*)(=)(?:\\{|\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" }
          }
        },
        {
          "name": "entity.other.attribute-name.html",
          "match": "[a-zA-Z_:][a-zA-Z0-9_:.-]*(?=\\s|=|>|/>)"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.lgui",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.lgui", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.lgui",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.lgui", "match": "\\\\." }
          ]
        },
        {
          "name": "string.template.lgui",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "name": "constant.character.escape.lgui", "match": "\\\\." },
            {
              "name": "meta.template.expression.lgui",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                { "include": "source.js" }
              ]
            }
          ]
        }
      ]
    },
    "javascript": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lgui",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.lgui",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "keyword.control.lgui",
          "match": "\\b(if|else|else\\s+if|for|while|do|switch|case|default|break|continue|return|yield|throw)\\b"
        },
        {
          "name": "keyword.declaration.lgui",
          "match": "\\b(const|let|var|function|async|await|class|extends|implements|interface|enum|namespace|type|of|in|instanceof|typeof|void|delete|new|static|readonly|private|protected|public)\\b"
        },
        {
          "name": "keyword.other.lgui",
          "match": "\\b(import|export|from|default|as|get|set)\\b"
        },
        {
          "name": "keyword.control.exception.lgui",
          "match": "\\b(try|catch|finally)\\b"
        },
        {
          "name": "constant.language.lgui",
          "match": "\\b(true|false|null|undefined|Infinity|NaN)\\b"
        },
        {
          "name": "variable.language.lgui",
          "match": "\\b(this|super|global|self)\\b"
        },
        {
          "name": "support.class.builtin.lgui",
          "match": "\\b(String|Array|Object|Number|Boolean|Date|RegExp|JSON|Promise|Map|Set|Symbol|WeakMap|WeakSet|ArrayBuffer|DataView|Uint8Array|Int8Array|Uint16Array|Int16Array|Uint32Array|Int32Array|Float32Array|Float64Array|BigInt64Array|BigUint64Array|Error|TypeError|ReferenceError|SyntaxError|RangeError|EvalError|URIError|AggregateError)\\b"
        },
        {
          "name": "support.function.builtin.lgui",
          "match": "\\b(console|Math|Reflect|Proxy|Intl)\\b"
        },
        {
          "name": "support.function.lgui",
          "match": "\\b(parseInt|parseFloat|isNaN|isFinite|encodeURI|encodeURIComponent|decodeURI|decodeURIComponent|eval|setTimeout|setInterval|clearTimeout|clearInterval|require|define|module)\\b"
        },
        {
          "name": "punctuation.accessor.lgui",
          "match": "\\."
        },
        {
          "name": "keyword.operator.arithmetic.lgui",
          "match": "(\\+|-|\\*|/|%|\\*\\*)"
        },
        {
          "name": "keyword.operator.assignment.lgui",
          "match": "(=|\\+=|-=|\\*=|/=|%=|\\*\\*=|&=|\\|=|\\^=|<<=|>>=|>>>=)"
        },
        {
          "name": "keyword.operator.logical.lgui",
          "match": "(===|!==|==|!=|<=|>=|<|>|&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.lgui",
          "match": "(&|\\||\\^|~|<<|>>|>>>)"
        },
        {
          "name": "keyword.operator.ternary.lgui",
          "match": "(\\?|:)"
        },
        {
          "name": "punctuation.arrow.lgui",
          "match": "=>"
        },
        {
          "name": "punctuation.spread.lgui",
          "match": "\\.\\.\\."
        },
        {
          "name": "constant.numeric.decimal.lgui",
          "match": "\\b(0|[1-9]\\d*)(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.hex.lgui",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.lgui",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.lgui",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.bigint.lgui",
          "match": "\\b(0|[1-9]\\d*)[nN]\\b"
        },
        {
          "name": "string.regexp.lgui",
          "begin": "/(?=[^/\\n])",
          "end": "/[gimsuvy]*",
          "patterns": [
            {
              "name": "constant.character.escape.lgui",
              "match": "\\\\."
            },
            {
              "name": "punctuation.character.set.begin.lgui",
              "match": "\\["
            },
            {
              "name": "punctuation.character.set.end.lgui",
              "match": "\\]"
            }
          ]
        },
        {
          "name": "punctuation.bracket.square.begin.lgui",
          "match": "\\["
        },
        {
          "name": "punctuation.bracket.square.end.lgui",
          "match": "\\]"
        },
        {
          "name": "punctuation.bracket.curly.begin.lgui",
          "match": "\\{"
        },
        {
          "name": "punctuation.bracket.curly.end.lgui",
          "match": "\\}"
        },
        {
          "name": "punctuation.bracket.round.begin.lgui",
          "match": "\\("
        },
        {
          "name": "punctuation.bracket.round.end.lgui",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.lgui",
          "match": ","
        },
        {
          "name": "punctuation.separator.semicolon.lgui",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.lgui",
          "match": ":"
        },
        {
          "name": "variable.name.lgui",
          "match": "[a-zA-Z_$][a-zA-Z0-9_$]*"
        }
      ]
    }
  }
}